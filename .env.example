# ==============================================================================
# INFRASTRUKTUR UTAMA (Vercel & Supabase)
# ==============================================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Akses Khusus Backend Serverless Vercel (Bypass RLS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-role-key
ENCRYPTION_MASTER_KEY=your-32-char-hex-encryption-key-for-pgcrypto

# Kunci Pengaman Webhook Heartbeat (cron-job.org)
CRON_SECRET_KEY=your-cron-secret-key

# ==============================================================================
# GOOGLE DRIVE STORAGE INTEGRATION (Sama seperti nfc-google-review)
# ==============================================================================
GDRIVE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your-google-client-secret
GDRIVE_REFRESH_TOKEN=your-google-oauth-refresh-token
GDRIVE_FOLDER_ID=your-google-drive-folder-id

# ==============================================================================
# META DEVELOPER PLATFORM (Facebook Page, Instagram Reels, Threads)
# ==============================================================================
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:5173/api/auth/meta-callback

# ==============================================================================
# TIKTOK DEVELOPER PORTAL (Direct Post API v2)
# ==============================================================================
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:5173/api/auth/tiktok-callback

# ==============================================================================
# SYSTEM LIMITS & SECURITY
# ==============================================================================
MAX_DAILY_POSTS=5
MIN_INTERVAL_MINUTES=60
MAX_VIDEO_SIZE_MB=100
MAX_IMAGE_SIZE_MB=10
